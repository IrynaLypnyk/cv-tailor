# Admin access configuration
# Password for the hidden /admin-login route
ADMIN_PASSWORD=

# Secret used to sign the admin session cookie (random string, min 32 chars)
ADMIN_SESSION_SECRET=some-random-string-min-32-chars

# LLM Provider configuration
# Supported: openai, mock
# Set LLM_PROVIDER=mock to use canned responses for UI/UX testing without consuming API tokens.
# All loading states and UI transitions are still exercised via simulated delays.
LLM_PROVIDER=openai #/ mock

# OpenAI configuration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
