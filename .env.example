# Admin access configuration
# Password for the hidden /admin-login route
ADMIN_PASSWORD=

# Secret used to sign the admin session cookie (random string, min 32 chars)
ADMIN_SESSION_SECRET=

# LLM Provider configuration
# Supported: openai
# Future: nebius (not yet implemented)
LLM_PROVIDER=openai

# OpenAI configuration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
